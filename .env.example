# --- LLM (required for the real agent; leave unset to run in mock mode) ---
ANTHROPIC_API_KEY=
MODEL=claude-opus-5
EFFORT=low

# --- Meta WhatsApp Cloud API (see ../meta_ids.md for the non-secret IDs) ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=1018490624686932
WHATSAPP_VERIFY_TOKEN=brightsmile-verify-2026
WHATSAPP_APP_SECRET=

# Receptionist number that gets the escalation ping (E.164 digits, no +)
RECEPTIONIST_PHONE=

PORT=8790
DB_PATH=./data/brightsmile.db

# OpenRouter alternative (used when ANTHROPIC_API_KEY is empty)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-oss-120b:free
